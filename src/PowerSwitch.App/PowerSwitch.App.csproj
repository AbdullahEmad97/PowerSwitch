<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets\PowerKeySwitch.ico</ApplicationIcon>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\PowerKeySwitch.ico" LogicalName="PowerSwitch.App.PowerKeySwitch.ico" />
    <ProjectReference Include="..\PowerSwitch.Core\PowerSwitch.Core.csproj" />
  </ItemGroup>
</Project>
